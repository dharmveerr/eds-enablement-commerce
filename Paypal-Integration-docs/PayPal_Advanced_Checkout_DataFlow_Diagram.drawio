</mxCell>
<mxCell id="v1008" value="API Mesh - Unified GraphQL Gateway&#10;&#10;Aggregates ACCS Commerce API AND App Builder&#10;PayPal checkout actions into one endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7F7;strokeColor=#0E7C8A;fontSize=12.5;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;fontColor=#000000;" vertex="1" parent="1">
