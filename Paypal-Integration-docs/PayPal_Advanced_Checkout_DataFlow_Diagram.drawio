</mxCell>
<mxCell id="v1007" value="Consumes one GraphQL endpoint (except client-side PayPal JS SDK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBF6;strokeColor=#79B899;fontSize=9.5;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;fontColor=#000000;" vertex="1" parent="1">
