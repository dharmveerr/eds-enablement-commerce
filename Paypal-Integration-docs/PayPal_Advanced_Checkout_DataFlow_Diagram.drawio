<mxCell id="t1001" value="PayPal Advanced Checkout Integration - EDS + API Mesh + App Builder + Adobe Commerce as a Cloud Service (SaaS)" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1A1A1A;whiteSpace=wrap;" vertex="1" parent="1">
  <mxGeometry x="20" y="5" width="1700" height="40" as="geometry"/>
</mxCell>
