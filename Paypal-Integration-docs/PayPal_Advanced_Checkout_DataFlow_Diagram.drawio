</mxCell>
<mxCell id="v1010" value="create-paypal-order&#10;&#10;POST /v2/checkout/orders&#10;(intent: AUTHORIZE | CAPTURE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B4FC7;fontSize=10.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;fontColor=#000000;" vertex="1" parent="1">
  <mxGeometry x="675" y="133" width="190" height="60" as="geometry"/>
</mxCell>
